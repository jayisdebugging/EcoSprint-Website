# EcoSprint Server Environment Variables
# Copy to .env and fill in real values. Never commit real secrets.

# SQLite (local/demo) or PostgreSQL
DATABASE_URL="file:./dev.db"

# JWT secrets - use long random strings in production
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-to-another-long-random-refresh-secret"

# Token lifetimes
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# Server
PORT=5000
NODE_ENV="development"

# Frontend origin for CORS
CLIENT_URL="http://localhost:3000"

# LinkedIn OAuth (optional - leave blank until you have real app credentials)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:5000/api/linkedin/callback"